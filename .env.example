# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AGENT_API_KEY: Used for authenticating requests to the AI Agent endpoint.
# API Key Exposure Mitigation: Never commit actual keys.
# Use a .env file (ignored by git) and a secrets manager in production.
AGENT_API_KEY="your_secure_api_key_here"
VITE_AGENT_API_KEY="your_secure_api_key_here"

# SMTP Configuration for real email sending
# These should be configured in the Secrets panel in AI Studio.
# NOTE: For Gmail, use an "App Password" from Google Account Security.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
SMTP_FROM_NAME="CreditFlow Recovery"
SMTP_FROM_EMAIL="recovery@creditflow.ai"

# Admin Credentials for UI Access
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="secure_password_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
